[sub_resource type="GDScript" id="GDScript_a3voq"]
script/source = "extends Node2D

@onready var mega_man: Player = $\"..\"
@onready var label: Label = $Label

var _turned_on: bool = false

func _process(_delta: float) -> void:

	if Input.is_action_just_pressed(\"debug_show\"):
		if _turned_on:
			_turned_on = false
		else:
			_turned_on = true
		label.visible = _turned_on

	if mega_man and _turned_on:
		label.text = \"State: \" + var_to_str(mega_man._current_state) + \"\\n\" \\
		+ \"Slide Tmr: \" + var_to_str(mega_man.slide_timer.time_left)
"

